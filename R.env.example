DB_DBMS=spark
DB_CONNECTION_STRING=jdbc:databricks://<server-hostname>:443;transportMode=http;ssl=1;httpPath=<http-path>;AuthMech=3;UID=token;PWD=<token>;EnableArrow=0
DB_USER=token
DB_PASSWORD=<token>
DB_PATH_TO_DRIVER=<folder-with-jdbc-driver>
CDM_DATABASE_SCHEMA=omop.data
COHORT_DATABASE_SCHEMA=<writable-schema>
COHORT_TABLE=hf_young_women_cohort
COHORT_ID=1295
OUTPUT_FOLDER=output
JAVA_PARAMETERS=-Dno.netty.nativeTlsOpenSsl=false -Dno.netty.allocType=unpooled
